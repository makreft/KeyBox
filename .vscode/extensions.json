    // Dieses Projekt wird mit VSCodium entwickelt, das Open VSX statt des
    // Microsoft-Marketplace benutzt. Die offizielle PlatformIO-Extension
    // (platformio.platformio-ide) liegt NUR im Marketplace und ist hier
    // deshalb nicht installierbar - stattdessen der angepasste Port.
    "recommendations": [
        "LordImmaculate.platformio-ide",
        "llvm-vs-code-extensions.vscode-clangd"
    ],
    // Die Microsoft-C/C++-Extension ist weder auf Open VSX verfuegbar noch
    // ausserhalb von echtem VS Code lizenziert. clangd uebernimmt das,
    // gefuettert aus compile_commands.json ("pio run -t compiledb").
    "unwantedRecommendations": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack"
    ]
}
